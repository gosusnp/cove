COVE_DEV=
DATABASE_URL=postgres://cove:covedev@localhost:5432/cove?sslmode=disable
# Required in production; falls back to DATABASE_URL in dev (COVE_DEV set).
# Should connect as a privileged user (e.g. cove_migrator) that owns the schema.
MIGRATION_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback
COVE_ALLOWED_EMAILS=
# 32-byte random key, base64-encoded. Generate with: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
SESSION_ENCRYPTION_KEY=

# Secret resolution precedence (all keys above support this):
#   1. $COVE_SECRETS_DIR/<key>  — mount a k8s Secret volume here for all app secrets
#   2. $<key>_FILE              — explicit file path, useful for operator-managed secrets
#                                 (e.g. DATABASE_URL_FILE=/run/secrets/db/uri for CNPG)
#   3. $<key>                   — plain env var (default for local dev)
#COVE_SECRETS_DIR=/run/secrets/cove
